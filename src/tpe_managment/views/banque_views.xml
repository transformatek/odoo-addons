<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_banque_form" model="ir.ui.view">
        <field name="name">banque.form</field>
        <field name="model">tpe.banque</field>
        <field name="arch" type="xml">
            <form string="Banque">
                <sheet>
                    <group>
                        <field name="code"/>
                        <field name="name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_banque_tree" model="ir.ui.view">
        <field name="name">banque.tree</field>
        <field name="model">tpe.banque</field>
        <field name="arch" type="xml">
            <tree string="Banques">
                <field name="code"/>
                <field name="name"/>
            </tree>
        </field>
    </record>

    <record id="action_banque" model="ir.actions.act_window">
        <field name="name">Banques</field>
        <field name="res_model">tpe.banque</field>
        <field name="view_mode">tree,form</field>
    </record> 

        <menuitem
            name="Banque"
            id="menu_tpe_banque"
            parent="tpe_managment.menu_tpe"
            action="action_banque"
            sequence="20" />

</odoo>

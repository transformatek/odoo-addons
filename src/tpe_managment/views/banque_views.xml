<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_banque_tree" model="ir.ui.view">
        <field name="name">banque.tree</field>
        <field name="model">tpe.banque</field>
        <field name="arch" type="xml">
            <tree string="Banques" editable="bottom">
                <field name="code" />
                <field name="name" />
                <field name="banque_image" />
            </tree>
        </field>
    </record>
<record id="view_banque_kanban" model="ir.ui.view">
    <field name="name">banque.kanban</field>
    <field name="model">tpe.banque</field>
    <field name="arch" type="xml">
        <kanban class="o_kanban_small_column">
            <field name="id"/>
            <field name="name"/>
            <field name="code"/>
            <field name="banque_image"/>
            <templates>
                <t t-name="kanban-box">
                    <div class="oe_kanban_global_click o_kanban_record_has_image_fill">
                        <t t-set="placeholder" t-value="'/base/static/img/company_image.png'"/>
                        <div class="o_kanban_image_fill_left o_kanban_image_full"
                             t-attf-style="background-image: url(#{kanban_image('tpe.banque', 'banque_image', record.id.raw_value, placeholder)})"
                             role="img"/>
                        <div class="oe_kanban_details d-flex flex-column text-center">
                            <strong class="o_kanban_record_title text-primary text-center" style="font-size: 16px;">
                                <field name="name"/>
                            </strong>
                          <span  style="font-size: 12px;">Code : <field name="code"/></span>
                          
                        </div>
                    </div>
                </t>
            </templates>
        </kanban>
    </field>
</record>




    <record id="action_banque" model="ir.actions.act_window">
        <field name="name">Banques</field>
        <field name="res_model">tpe.banque</field>
        <field name="view_mode">kanban,tree,form</field>
    </record>

    <menuitem
        name="Banque"
        id="menu_tpe_banque"
        parent="tpe_managment.menu_tpe"
        action="action_banque"
        sequence="20" />

</odoo>
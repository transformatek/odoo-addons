<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_constructor_form" model="ir.ui.view">
        <field name="name">constructor.form</field>
        <field name="model">tpe.constructor</field>
        <field name="arch" type="xml">
            <form string="Constructeur">
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_constructor_tree" model="ir.ui.view">
        <field name="name">constructor.tree</field>
        <field name="model">tpe.constructor</field>
        <field name="arch" type="xml">
            <tree string="Constructeurs">
                <field name="name"/>
            </tree>
        </field>
    </record>

    <menuitem id="menu_constructor" name="Constructeurs" parent="tpe_managment.menu_tpe" action="action_constructor"/>

    <record id="action_constructor" model="ir.actions.act_window">
        <field name="name">Constructeurs</field>
        <field name="res_model">tpe.constructor</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>

<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_constructor_tree" model="ir.ui.view">
        <field name="name">constructor.tree</field>
        <field name="model">tpe.constructor</field>
        <field name="arch" type="xml">
            <tree string="Constructeurs" editable="bottom">
                <field name="name" />
            </tree>
        </field>
    </record>

    <record id="action_constructor" model="ir.actions.act_window">
        <field name="name">Constructeurs</field>
        <field name="res_model">tpe.constructor</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_constructor" name="Constructeurs" parent="tpe_managment.menu_tpe" action="action_constructor" sequence="40" />


</odoo>
<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_tpe_model_tree" model="ir.ui.view">
        <field name="name">tpe.model.tree</field>
        <field name="model">tpe.model</field>
        <field name="arch" type="xml">
            <tree string="Modèles TPE" editable="bottom">
                <field name="name" />
                <field name="constructor_id" />
                <field name="model_image" />
            </tree>
        </field>
    </record>

    <record id="view_model_kanban" model="ir.ui.view">
    <field name="name">model.kanban</field>
    <field name="model">tpe.model</field>
    <field name="arch" type="xml">
        <kanban class="o_kanban_small_column">
            <field name="id"/>
            <field name="name"/>
            <field name="constructor_id"/>
            <field name="model_image"/>
            <templates>
                <t t-name="kanban-box">
                    <div class="oe_kanban_global_click o_kanban_record_has_image_fill">
                        <div class="o_kanban_image_fill_left o_kanban_image_full"
                             t-attf-style="background-image: url(#{kanban_image('tpe.model', 'model_image', record.id.raw_value, placeholder)})"
                             role="img"/>
                        <div class="oe_kanban_details d-flex flex-column text-center">
                            <strong class="o_kanban_record_title text-primary text-center" style="font-size: 16px;">
                                <field name="name"/>
                            </strong>
                            <br/>
                            <span  style="font-weight: bold;">
                                Constructeur : <field name="constructor_id"/>
                            </span>
                           
                        </div>
                    </div>
                </t>
            </templates>
        </kanban>
    </field>
</record>

    <record id="action_tpe_model" model="ir.actions.act_window">
        <field name="name">Model</field>
        <field name="res_model">tpe.model</field>
        <field name="view_mode">kanban,tree,form</field>
    </record>
    <menuitem id="menu_tpe_model" name="Model" parent="tpe_managment.menu_tpe" action="action_tpe_model" sequence="30" />

</odoo>
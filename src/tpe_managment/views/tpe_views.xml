<?xml version="1.0" encoding="UTF-8"?>
<odoo>


    <record id="view_tpe_form" model="ir.ui.view">
        <field name="name">tpe.form</field>
        <field name="model">tpe.tpe</field>
        <field name="arch" type="xml">
            <form string="TPE">
                <sheet>
                    <header>
                        <field name="state" widget="statusbar"
                            statusbar_visible="new,planned,in_progress,done,blocked,cancelled"
                            clickable="1" />
                    </header>

                    <group>
                        <separator string="Commerçant" colspan="2" />
                        <group>
                            <field name="name" />
                            <field name="contact_name" />
                            <field name="enseigne" />
                            <field name="mobile" />
                            <field name="street" />
                            <field name="city" />
                            <field name="company_id" />
                        </group>
                    </group>

                    <group>
                        <separator string="Banque" colspan="2" />
                        <group>
                            <field name="bank_name" />
                            <field name="order" />
                        </group>
                    </group>

                    <group>
                        <separator string="TPE" colspan="2" />
                        <group>
                            <field name="constructor_name" />
                            <field name="model_name" />
                            <field name="serie_number" />
                            <field name="operator" />
                        </group>
                    </group>

                    <group>
                        <separator string="Installateur" colspan="2" />
                        <group>
                            <field name="wilaya_name" />
                            <field name="installation_date" />

                        </group>
                    </group>


                    <notebook>
                        <page string="Observations">
                            <field name="observation" />
                        </page>
                        <page string="Observations client">
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_tpe_kanban" model="ir.ui.view">
        <field name="name">tpe.kanban</field>
        <field name="model">tpe.tpe</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_view" default_group_by="state">
                <field name="name" />
                <field name="serie_number" />
                <field name="bank_name" />
                <field name="operator" />
                <field name="contact_name" />
                <field name="city" />
                <field name="state" />
                <templates>
                    <t t-name="kanban-box">

                        <div t-attf-class="oe_kanban_card oe_kanban_global_click" t-att-data-id="record.id">
                            <div class="oe_kanban_header text-center">
                                <strong>
                                    <i class="fa fa-credit-card" style="color:#007bff;"></i>
                                    <t t-esc="record.name.value or 'Sans Nom'" />
                                </strong>
                            </div>

                            <div class="oe_kanban_content">
                                <div class="text-primary">
                                    <i class="fa fa-barcode"></i>
                                    <span t-esc="record.serie_number.value or 'N/A'" />
                                </div>
                                <div>
                                    <strong><i class="fa fa-bank"></i> Banque :</strong>
                                    <t t-esc="record.bank_name.value or 'Non défini'" />
                                </div>
                                <div>
                                    <strong><i class="fa fa-wifi"></i> Opérateur :</strong>
                                    <t t-esc="record.operator.value or 'Non défini'" />
                                </div>
                            </div>

                            <div class="oe_kanban_footer text-primary">
                                <t t-if="record.contact_name.value">
                                    <i class="fa fa-user"></i>
                                    <t t-esc="record.contact_name.value" />
                                </t>
                                <t t-if="record.city.value"> | <i class="fa fa-map-marker"></i> 
                                    <t t-esc="record.city.value" />
                                </t>
                            </div>
                        </div>

                    </t>
                </templates>
            </kanban>
        </field>
    </record>


    <record id="view_tpe_tree" model="ir.ui.view">
        <field name="name">tpe.tree</field>
        <field name="model">tpe.tpe</field>
        <field name="arch" type="xml">
            <tree string="TPEs">
                <field name="name" />
                <field name="serie_number" />
                <field name="wilaya_name" />
                <field name="city" />
                <!-- <field name="bank_name" /> -->
                <!-- <field name="operator" /> -->
                <!-- <field name="contact_name" /> -->
                <field name="state" widget="badge"
                    decoration-info="state == 'new'"
                    decoration-primary="state == 'planned'"
                    decoration-warning="state == 'in_progress'"
                    decoration-success="state == 'done'"
                    decoration-danger="state == 'blocked'"
                    decoration-muted="state == 'cancelled'" />
            </tree>
        </field>
    </record>


    <record id="view_tpe_model_search" model="ir.ui.view">
        <field name="name">tpe.search</field>
        <field name="model">tpe.tpe</field>
        <field name="arch" type="xml">
            <search string="TPE Search">
                <field name="wilaya_name" />
                <field name="model_name" />
                <field name="bank_name" />
                <field name="state" />
                <separator />
                <filter string="New" name="New" domain="[('state', '=', 'new')]" help="" />
                <filter string="Planned" name="planned" domain="[('state', '=', 'planned')]" help="" />
                <filter string="In Progress" name="In Progress" domain="[('state', '=', 'in_progress')]" help="" />
                <filter string="Done" name="Done" domain="[('state', '=', 'done')]" />
                <filter string="Blocked" name="Blocked" domain="[('state', '=', 'blocked')]" />
                <filter string="Cancelled" name="Cancelled" domain="[('state', '=', 'cancelled')]" />

                <group expand="0" string="Group By">
                    <filter string="Wilaya" name="Wilaya" context="{'group_by': 'wilaya_name'}" />
                    <filter string="Model" name="Model" context="{'group_by': 'model_name'}" />
                    <filter string="Bank" name="Bank" context="{'group_by': 'bank_name'}" />
                </group>
            </search>

        </field>
    </record>

    <record id="action_tpe" model="ir.actions.act_window">
        <field name="name">TPE</field>
        <field name="res_model">tpe.tpe</field>
        <field name="view_mode">tree,kanban,form</field>
    </record>
    <menuitem id="menu_tpe_tpe" name="Terminal" parent="tpe_managment.menu_tpe" action="action_tpe" sequence="1" />

</odoo>
<?xml version="1.0" encoding="UTF-8"?>
<odoo>


<record id="view_tpe_form" model="ir.ui.view">
    <field name="name">tpe.form</field>
    <field name="model">tpe.tpe</field>
    <field name="arch" type="xml">
        <form string="TPE">
            <sheet>
                <header>
                    <field name="state" widget="statusbar" 
                           statusbar_visible="new,planned,in_progress,done,blocked,cancelled" 
                           clickable="1"/>
                </header>
                
                <group>
                    <separator string="Commerçant" colspan="2"/>
                    <group>
                        <field name="contact_id"/>
                        <field name="mobile"/>
                        <field name="street"/>
                        <field name="city"/>
                    </group>
                </group>
                
                <group>
                    <separator string="Banque" colspan="2"/>
                    <group>
                        <field name="bank_id"/>
                        <!-- <field name="order"/> -->
                    </group>
                </group>
                
                <group>
                    <separator string="TPE" colspan="2"/>
                    <group>
                        <field name="constructor_id"/>
                        <field name="model_id"/>
                        <field name="serie_number"/>
                        <field name="operator"/>
                    </group>
                </group>

                  <group>
                    <separator string="Installateur" colspan="2"/>
                    <group>
                        <field name="wilaya_id"/>
                        <field name="installation_date"/>
                        
                    </group>
                </group>


                
     
                
                <notebook>
                    <page string="Observations">
                        <field name="observation"/>
                    </page>
                    <page string="Observations client">
                    </page>
                </notebook>
            </sheet>
        </form>
    </field>
</record>

    <record id="view_tpe_tree" model="ir.ui.view">
        <field name="name">tpe.tree</field>
        <field name="model">tpe.tpe</field>
        <field name="arch" type="xml">
            <tree string="TPEs">
                <field name="name" />
                <field name="serie_number" />
                <field name="bank_id" />
                <field name="operator" />
                <field name="contact_id" />
                <!-- TODO add state with Badges -->
            </tree>
        </field>
    </record>

    <!-- TODO add filters by Wialya, model, bank, ...  -->
    <!-- TODO add group by for Wialya, model, bank, ...  -->

    <record id="action_tpe" model="ir.actions.act_window">
        <field name="name">TPE</field>
        <field name="res_model">tpe.tpe</field>
        <field name="view_mode">tree,form</field>
    </record>
    <menuitem id="menu_tpe_tpe" name="Terminal" parent="tpe_managment.menu_tpe" action="action_tpe" sequence="1" />

</odoo>
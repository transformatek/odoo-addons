<odoo>
    <record id="action_report_tpe_installation" model="ir.actions.report">
        <field name="name">Fiche d'installation TPE</field>
        <field name="model">tpe.tpe</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">tpe_managment.report_tpe_installation</field>
        <field name="report_file">tpe_managment.report_tpe_installation</field>
        <field name="print_report_name">'Installation TPE - %s' % (object.name)</field>
        <field name="binding_model_id" ref="model_tpe_tpe" />
        <field name="binding_type">report</field>
    </record>
    <template id="report_tpe_installation">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="tpe">

<odoo>
    <record id="action_report_tpe_installation" model="ir.actions.report">
        <field name="name">Fiche d'installation TPE</field>
        <field name="model">tpe.tpe</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">tpe_managment.report_tpe_installation</field>
        <field name="report_file">tpe_managment.report_tpe_installation</field>
        <field name="print_report_name">'Installation TPE - %s' % (object.name)</field>
        <field name="binding_model_id" ref="model_tpe_tpe" />
        <field name="binding_type">report</field>
    </record>
    <template id="report_tpe_installation">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="tpe">
                <div class="page" style="page-break-before: always;">
                    <table border="1" style="width: 100%; border-collapse: collapse; margin-bottom: 15px; border: 1px solid black; border-spacing: 0;">
                        <tr style="height: 75px;">
                            <td style="width: 25%; text-align: center; border: 3px solid black; vertical-align: middle;">
                                <t t-if="tpe.company_id.logo">
                                    <img t-att-src="image_data_uri(tpe.company_id.logo)" style="max-height: 45px;" alt="Logo" />
                                </t>
                            </td>
                            <td style="width: 50%; text-align: center; font-size: 18px; font-weight: bold; border: 3px solid black; vertical-align: middle;">
                                <h3 style="margin: 0;">FICHE D'INSTALLATION</h3>
                            </td>
                            <td style="width: 25%; text-align: left; border: 3px solid black; vertical-align: middle;">
                                <p style="margin: 0; padding-left: 10px;">Réf : <t t-esc="tpe.bank_name" />/SSB/ <t t-esc="tpe.id" />
                                </p>
                            </td>
                        </tr>
                    </table>


                    <table border="1" style="width: 100%; border-collapse: collapse; margin-bottom: 15px; border: 1px solid black;">
                        <tr>
                            <td colspan="4">
                                <h3>Commerçant</h3>
                            </td>
                        </tr>
                        <tr>
                            <td style="width: 20%;">
                                <strong>Nom :</strong>
                            </td>
                            <td style="width: 80%;">
                                <t t-esc="tpe.name" />
                            </td>
                        </tr>
                        <tr>
                            <td style="width: 20%;">
                                <strong>Enseigne :</strong>
                            </td>
                            <td style="width: 80%;">
                                <t t-esc="tpe.enseigne or ''" />
                            </td>
                        </tr>
                        <tr>
                            <td style="width: 20%;">
                                <strong>Téléphone :</strong>
                            </td>
                            <td style="width: 80%;">0<t t-esc="tpe.mobile or ''" /></td>
                        </tr>
                        <tr>
                            <td style="width: 20%;">
                                <strong>Adresse :</strong>
                            </td>
                            <td style="width: 80%;">
                                <t t-esc="tpe.street or ''" />
                            </td>
                        </tr>
                        <tr>
                            <td style="width: 20%;">
                                <strong>Wilaya :</strong>
                            </td>
                            <td style="width: 40%;">
                                <t t-esc="tpe.wilaya_name or ''" />
                                <t t-esc="tpe.city or ''" />
                            </td>
                        </tr>
                    </table>

                    <table border="1" style="width: 100%; border-collapse: collapse; margin-bottom: 15px; border: 1px solid black;">
                        <tr>
                            <td colspan="4">
                                <h3>Banque</h3>
                            </td>
                        </tr>
                        <tr>
                            <td style="width: 20%;">
                                <strong>Banque :</strong>
                            </td>
                            <td style="width: 40%;">
                                <t t-esc="tpe.bank_name or ''" />
                            </td>
                        </tr>
                        <tr>
                            <td style="width: 20%;">
                                <strong>Commande :</strong>
                            </td>
                            <td style="width: 80%;">
                                <t t-esc="tpe.order or ''" />
                            </td>
                        </tr>
                    </table>

                    <table border="1" style="width: 100%; border-collapse: collapse; margin-bottom: 15px; border: 1px solid black;">
                        <tr>
                            <td colspan="4">
                                <h3>Terminal de Paiement (TPE)</h3>
                            </td>
                        </tr>
                        <tr>
                            <td style="width: 20%;">
                                <strong>Marque :</strong>
                            </td>
                            <td style="width: 80%;">
                                <t t-esc="tpe.constructor_name or ''" />
                            </td>
                        </tr>
                        <tr>
                            <td style="width: 20%;">
                                <strong>Modèle :</strong>
                            </td>
                            <td style="width: 80%;">
                                <t t-esc="tpe.model_name or ''" />
                            </td>
                        </tr>
                        <tr>
                            <td style="width: 20%;">
                                <strong>N° de Série :</strong>
                            </td>
                            <td style="width: 80%;">
                                <t t-esc="tpe.serie_number or ''" />
                            </td>
                        </tr>
                        <tr>
                            <td style="width: 20%;">
                                <strong>SIM :</strong>
                            </td>
                            <td style="width: 80%;">
                                <t t-esc="tpe.operator or ''" />
                            </td>
                        </tr>
                        <tr>
                            <td style="width: 20%;">
                                <strong>ID du terminal :</strong>
                            </td>
                            <td style="width: 80%;">
                                <t t-esc="tpe.terminal_id or ''" />
                            </td>
                        </tr>
                    </table>

                    <table border="1" style="width: 100%; border-collapse: collapse; margin-bottom: 15px; border: 1px solid black;">
                        <tr>
                            <td colspan="4">
                                <h3>Installateur</h3>
                            </td>
                        </tr>
                        <tr>
                            <td>
                                <strong>Nom :</strong>
                            </td>
                            <td>BENAHMED DAHO Ali SARL TRANSFORMATEK</td>
                            <td>
                                <strong>Matricule :</strong>
                            </td>
                            <td>051200005</td>
                        </tr>
                    </table>


                    <table border="1" style="width: 100%; border-collapse: collapse; margin-bottom: 15px; border: 1px solid black;">
                        <tr>
                            <td colspan="5">
                                <h3>Historique de l'installation</h3>
                            </td>
                        </tr>
                        <tr>
                            <td style="border: none;width:25%;">Formation ☐</td>
                            <td style="border: none;width:25%;">Manuel ☐</td>
                            <td style="border: none;width:25%;">Information sur l'obligation de changement mot de passe ☐</td>
                            <td style="border: none;width:25%;">Consommable (Papier) ☐ <br /> QT :..................... </td>
                        </tr>
                    </table>

                    <table border="1" style="width: 100%; border-collapse: collapse; margin-bottom: 15px; border: 1px solid black;">
                        <tr>
                            <td colspan="4">
                                <h3>Installation</h3>
                            </td>
                        </tr>
                        <tr>
                            <td><strong>Date d'installation :</strong> ...... / ...... / ...... </td>
                        </tr>
                        <tr>
                            <td>
                                <strong>Observation client :</strong>
                                <br />
                                <br />
                                <br />
                                <br />
                            </td>
                        </tr>
                    </table>


                    <table border="1" style="width: 100%; border-collapse: collapse; margin-bottom: 15px; border: 1px solid black;">
                        <tr>
                            <td colspan="4">
                                <h3>VISA</h3>
                            </td>
                        </tr>
                        <tr>
                            <td>
                                <b>Client</b>
                            </td>
                            <td>
                                <b>SSB</b>
                            </td>
                        </tr>
                        <tr>
                            <td style="height: 150px;"></td>
                            <td style="height: 150px;"></td>
                        </tr>
                    </table>
                    <i>Le commerçant s'engage à procéder au changement du mot de passe du TPE</i>
                </div>
            </t>
        </t>
    </template>


</odoo>